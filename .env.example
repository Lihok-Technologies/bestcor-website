# ------------------------------------------------------------------
# BESTCOR PHILS., INC. — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, robots, OpenGraph).
# Set the same value on Render so production metadata is correct.
# NEXT_PUBLIC_SITE_URL=https://bestcor.ph

# ------------------------------------------------------------------
# Quotation email delivery (server-side only — via Resend).
# ------------------------------------------------------------------
# Without these variables the quotation form stays honest: submissions are
# NOT sent, the page says delivery is not enabled, and visitors get an
# email-fallback button to info@bestcor.ph. The site never
# claims a request was delivered unless the provider accepted it.

# 1) Resend API key (create a free account at resend.com).
#    Never expose this value client-side.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 2) Sender identity. A verified sending domain is recommended.
#    Interim option without a domain: Resend allows sending from
#    "onboarding@resend.dev", but ONLY to the email address registered on
#    the Resend account. For real Bestcor delivery before a domain is
#    Preferred: a verified Bestcor-owned sending domain (e.g. @bestcor.ph)
#    configured in Resend, then set:
# BESTCOR_QUOTATION_FROM_EMAIL=onboarding@resend.dev

# 3) Recipient — defaults to the published Bestcor email when unset.
# BESTCOR_QUOTATION_TO_EMAIL=info@bestcor.ph
