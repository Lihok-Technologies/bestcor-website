# ------------------------------------------------------------------
# BESTCOR PHILS., INC. — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, robots, OpenGraph).
# Set the same value on Render so production metadata is correct.
# NEXT_PUBLIC_SITE_URL=https://bestcor-website.onrender.com

# Quotation intake — OPTIONAL for v1.
# The contact form works today without any of these: submissions go through
# an honest "email this request" fallback to bestcorofficial2005@gmail.com
# and the site NEVER claims a submission was delivered unless it truly was.
#
# To enable direct delivery, point at any endpoint that accepts a JSON POST
# (a future Resend/SMTP relay, a dedicated Bestcor Supabase Edge Function,
# Zapier/Make webhook, etc.). The website posts:
#   { source, form, to, payload:{name,company,email,phone,location,
#     service,description,schedule,consent,submittedAt} }
# and reports success ONLY on a 2xx response.
#
# QUOTATION_WEBHOOK_URL=https://example.com/hooks/bestcor-quotation
